# ============================================================
# Root .gitignore for the ABC / AUTOSAR project workspace
# ============================================================

# ---- macOS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
Icon?
*.icloud

# ---- Windows ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Linux ----
*~
.directory

# ---- Editors / IDEs ----
.vscode/settings.json
.vscode/launch.json
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- VS Code Extension (autosar-code-locator) ----
autosar-code-locator/node_modules/
autosar-code-locator/dist/
autosar-code-locator/out/
autosar-code-locator/*.vsix

# ---- C / C++ build artifacts (sample-project) ----
*.o
*.obj
*.elf
*.hex
*.bin
*.map
*.lst
*.a
*.lib
*.d
*.out
build/
Debug/
Release/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Environment ----
.env
.env.local
.env.*.local

# ---- GitNexus index (machine-specific, regenerated) ----
**/.gitnexus/

# ---- Temp / generated ----
*.tmp
*.temp
*.bak
*.cache
coverage/
